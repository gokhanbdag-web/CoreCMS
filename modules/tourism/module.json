{
  "id": "tourism",
  "name": "Turizm ve Tur",
  "description": "Turlar, destinasyonlar, kalkış takvimi, kapasite yönetimi ve rezervasyon talepleri.",
  "category": "Turizm",
  "version": "1.0.0",
  "minimum_core_version": "0.1.0",
  "dependencies": [],
  "permissions": [
    "tours.view",
    "tours.manage",
    "destinations.manage",
    "departures.manage",
    "bookings.manage"
  ],
  "routes": [
    {
      "path": "/turlar",
      "methods": [
        "GET"
      ],
      "handler": "Frontend/listings.php"
    },
    {
      "path": "/turlar/rezervasyon",
      "methods": [
        "POST"
      ],
      "handler": "Frontend/booking-submit.php"
    },
    {
      "path": "/turlar/{slug}",
      "methods": [
        "GET"
      ],
      "handler": "Frontend/detail.php"
    }
  ],
  "assets": [
    "css/tourism.css"
  ],
  "templates": [],
  "migrations": "migrations/",
  "provisioning": {
    "pages": [],
    "menus": [
      {
        "key": "tourism-tours",
        "menu_key": "main",
        "label": "Turlar",
        "url": "/turlar",
        "sort_order": 16
      }
    ]
  },
  "demo_packages": [
    {
      "id": "coastal",
      "name": "Sahil Turizmi Demo Paketi",
      "description": "Turlar, destinasyonlar ve rezervasyon sayfalarını ana menüye ekler.",
      "pages": {},
      "menus": {}
    }
  ]
}
