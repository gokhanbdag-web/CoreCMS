{
  "id": "real-estate",
  "name": "Emlak Yönetimi",
  "description": "Satılık ve kiralık ilanlar, danışmanlar, gelişmiş portföy araması ve müşteri talepleri.",
  "category": "Gayrimenkul",
  "version": "1.0.0",
  "minimum_core_version": "0.1.0",
  "dependencies": [],
  "permissions": [
    "listings.view",
    "listings.manage",
    "agents.manage",
    "leads.manage"
  ],
  "routes": [
    {
      "path": "/emlak",
      "methods": [
        "GET"
      ],
      "handler": "Frontend/listings.php"
    },
    {
      "path": "/emlak/ilan/{slug}",
      "methods": [
        "GET"
      ],
      "handler": "Frontend/detail.php"
    },
    {
      "path": "/emlak/talep",
      "methods": [
        "POST"
      ],
      "handler": "Frontend/lead-submit.php"
    }
  ],
  "assets": [
    "css/real-estate.css"
  ],
  "templates": [],
  "migrations": "migrations/",
  "provisioning": {
    "pages": [],
    "menus": [
      {
        "key": "real-estate-portfolio",
        "menu_key": "main",
        "label": "Emlak Portföyü",
        "url": "/emlak",
        "sort_order": 15
      }
    ]
  },
  "demo_packages": [
    {
      "id": "starter",
      "name": "Emlak Başlangıç Paketi",
      "description": "Portföy sayfasını ana menüye ekler; gerçek ilan yönetimi modül ekranından yapılır.",
      "pages": {},
      "menus": {}
    }
  ]
}
